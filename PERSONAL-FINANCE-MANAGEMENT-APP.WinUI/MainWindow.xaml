<Window
    x:Class="PersonalFinanceWinUI.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="Personal Finance WinUI">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="52"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Background="{StaticResource BrandBlueBrush}" Padding="18,8" Grid.Row="0">
            <TextBlock Text="Finance Manager" Foreground="White" FontSize="26" FontWeight="SemiBold"/>
        </Border>

        <NavigationView x:Name="AppNavView" Grid.Row="1" IsBackButtonVisible="Collapsed" IsPaneOpen="True" PaneDisplayMode="Left" SelectionChanged="AppNavView_SelectionChanged">
            <NavigationView.MenuItems>
                <NavigationViewItem Content="Tong quan" Tag="dashboard" Icon="Home"/>
                <NavigationViewItem Content="Them giao dich" Tag="add" Icon="Add"/>
                <NavigationViewItem Content="Bao cao" Tag="reports" Icon="Document"/>
                <NavigationViewItem Content="Lien ket ngan hang" Tag="bank" Icon="Contact"/>
                <NavigationViewItem Content="Cloud Sync" Tag="sync" Icon="Sync"/>
            </NavigationView.MenuItems>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem Content="Dang xuat" Tag="logout">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8AC;"/>
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="ContentFrame" Background="{StaticResource SoftBgBrush}"/>
        </NavigationView>
    </Grid>
</Window>
