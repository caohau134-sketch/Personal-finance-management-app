<Page
    x:Class="PersonalFinanceWinUI.App.Pages.ReportsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="18" Spacing="10">
        <TextBlock Text="Bao cao giao dich" FontSize="30" FontWeight="SemiBold"/>
        <Border Padding="12" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Background="White">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <DatePicker x:Name="FromDate" Header="Tu ngay"/>
                <DatePicker x:Name="ToDate" Header="Den ngay"/>
                <Button Content="Loc du lieu" VerticalAlignment="Bottom" Click="Filter_Click" Background="{StaticResource BrandBlueBrush}" Foreground="White"/>
            </StackPanel>
        </Border>
        <Border Padding="10" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Background="White">
            <ListView x:Name="ReportList"/>
        </Border>
    </StackPanel>
</Page>
