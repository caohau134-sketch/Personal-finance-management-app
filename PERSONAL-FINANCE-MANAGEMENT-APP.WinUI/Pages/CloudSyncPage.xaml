<Page
    x:Class="PersonalFinanceWinUI.App.Pages.CloudSyncPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Padding="18" Spacing="12">
        <TextBlock Text="Cloud Sync" FontSize="30" FontWeight="SemiBold"/>
        <Border Padding="12" CornerRadius="12" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="White">
            <StackPanel Spacing="10">
                <TextBlock Text="Dong bo du lieu local len Firebase (transactions + bank links)." TextWrapping="Wrap"/>
                <Button Content="Dong bo ngay" Click="SyncNow_Click" Background="{StaticResource BrandBlueBrush}" Foreground="White" Width="180"/>
                <TextBlock x:Name="SyncStatusText"/>
            </StackPanel>
        </Border>
    </StackPanel>
</Page>
