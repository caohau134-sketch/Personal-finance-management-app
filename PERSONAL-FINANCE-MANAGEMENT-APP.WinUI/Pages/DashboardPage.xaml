<Page
    x:Class="PersonalFinanceWinUI.App.Pages.DashboardPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer>
        <StackPanel Spacing="14" Padding="18">
            <TextBlock Text="Tong quan tai chinh" FontSize="30" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="12">
                <Border Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Width="350" Background="White"><TextBlock x:Name="IncomeText" FontSize="22" FontWeight="SemiBold" Foreground="#2B6D2B"/></Border>
                <Border Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Width="350" Background="White"><TextBlock x:Name="ExpenseText" FontSize="22" FontWeight="SemiBold" Foreground="#A33A2C"/></Border>
                <Border Padding="16" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Width="350" Background="White"><TextBlock x:Name="BalanceText" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource BrandBlueBrush}"/></Border>
            </StackPanel>
            <Border Padding="14" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Background="White">
                <StackPanel Spacing="8">
                    <TextBlock Text="Tien do ngan sach thang" FontSize="18" FontWeight="SemiBold"/>
                    <ProgressBar x:Name="BudgetProgress" Height="18"/>
                    <TextBlock x:Name="BudgetStatusText"/>
                </StackPanel>
            </Border>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Padding="12" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Giao dich gan nhat" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListView x:Name="RecentTransactionsList"/>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Padding="12" BorderThickness="1" BorderBrush="{StaticResource CardBorderBrush}" CornerRadius="12" Background="White">
                    <StackPanel>
                        <TextBlock Text="Chi theo danh muc" FontSize="20" FontWeight="SemiBold" Margin="0,0,0,8"/>
                        <ListView x:Name="CategoryList"/>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</Page>
