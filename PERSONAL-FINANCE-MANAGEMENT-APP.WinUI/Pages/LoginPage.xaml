<Page
    x:Class="PersonalFinanceWinUI.App.Pages.LoginPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource SoftBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="1" Padding="28" Width="620" CornerRadius="18" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="White">
            <StackPanel Spacing="10">
                <StackPanel HorizontalAlignment="Center" Margin="0,4,0,12">
                    <TextBlock Text="Finance Manager" FontSize="42" FontWeight="SemiBold" HorizontalAlignment="Center"/>
                    <TextBlock Text="Quan ly thu chi ca nhan" FontSize="20" Opacity="0.7" HorizontalAlignment="Center"/>
                </StackPanel>

                <TextBox x:Name="NameBox" Header="Ho ten (dang ky)" PlaceholderText="Nhap ho ten"/>
                <TextBox x:Name="EmailBox" Header="Email" PlaceholderText="example@gmail.com"/>
                <PasswordBox x:Name="PasswordBox" Header="Mat khau"/>
                <PasswordBox x:Name="ConfirmPasswordBox" Header="Nhap lai mat khau (dang ky)"/>
                <ComboBox x:Name="RoleBox" Header="Vai tro" Width="220">
                    <ComboBoxItem Content="User" IsSelected="True"/>
                    <ComboBoxItem Content="Admin"/>
                </ComboBox>
                <TextBox x:Name="ParentEmailBox" Header="Email phu huynh (tu chon)"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Content="Dang nhap" Click="Login_Click" Background="{StaticResource BrandBlueBrush}" Foreground="White"/>
                    <Button Content="Dang ky" Click="Register_Click"/>
                </StackPanel>
                <TextBlock x:Name="StatusText" Foreground="IndianRed" Margin="0,6,0,0"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
