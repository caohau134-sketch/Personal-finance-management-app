<Page
    x:Class="PersonalFinanceWinUI.App.Pages.AddTransactionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Background="{StaticResource SoftBgBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="1" Width="700" Padding="20" CornerRadius="16" BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="1" Background="White">
            <StackPanel Spacing="10">
                <TextBlock Text="+ Thêm giao dịch mới" FontSize="28" FontWeight="SemiBold"/>
                <ComboBox x:Name="TypeBox" Header="Loai giao dich" SelectionChanged="TypeBox_SelectionChanged">
                    <ComboBoxItem Content="Chi tiêu" IsSelected="True"/>
                    <ComboBoxItem Content="Thu nhập"/>
                </ComboBox>
                <TextBox x:Name="AmountBox" Header="Số tiền (VND)"/>
                <ComboBox x:Name="CategoryGroupBox" Header="Nhóm danh mục" SelectionChanged="CategoryGroupBox_SelectionChanged"/>
                <ComboBox x:Name="CategoryDetailBox" Header="Danh mục chi tiết"/>
                <TextBox x:Name="NoteBox" Header="Ghi chú"/>
                <TextBox x:Name="SourceBox" Header="Nguồn tiền (lương/chuyển khoản/tiền mặt...)"/>
                <CheckBox x:Name="EssentialBox" Content="Chi tiêu thiết yếu"/>
                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,8,0,0">
                    <Button Content="Lưu" Click="Save_Click" Background="{StaticResource BrandBlueBrush}" Foreground="White"/>
                </StackPanel>
                <TextBlock x:Name="ResultText"/>
            </StackPanel>
        </Border>
    </Grid>
</Page>
